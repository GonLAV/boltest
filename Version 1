    // Drag and Drop Handlers
    function handleDragStart(e) {
      draggedStep = this;
      this.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
    }

    function handleDragOver(e) {
      if (e.preventDefault) {
        e.preventDefault();
      }
      e.dataTransfer.dropEffect = 'move';
      return false;
    }

    function handleDrop(e) {
      if (e.stopPropagation) {
        e.stopPropagation();
      }

      if (draggedStep !== this) {
        const allSteps = Array.from(document.querySelectorAll('.step-item'));
        const draggedIndex = allSteps.indexOf(draggedStep);
        const targetIndex = allSteps.indexOf(this);

        if (draggedIndex < targetIndex) {
          this.parentNode.insertBefore(draggedStep, this.nextSibling);
        } else {
          this.parentNode.insertBefore(draggedStep, this);
        }

        updateStepNumbers();
      }

      return false;
    }

    function handleDragEnd(e) {
      this.classList.remove('dragging');
    }

    // Move Step Up
    function moveStepUp(button) {
      const stepItem = button.closest('.step-item');
      const prevStep = stepItem.previousElementSibling;
      if (prevStep && !prevStep.classList.contains('empty-state')) {
        stepItem.parentNode.insertBefore(stepItem, prevStep);
        updateStepNumbers();
        showToast('✅', 'Moved!', 'Step moved up');
      }
    }

    // Move Step Down
    function moveStepDown(button) {
      const stepItem = button.closest('.step-item');
      const nextStep = stepItem.nextElementSibling;
      if (nextStep) {
        stepItem.parentNode.insertBefore(nextStep, stepItem);
        updateStepNumbers();
        showToast('✅', 'Moved!', 'Step moved down');
      }
    }

