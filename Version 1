    // Handle Attachment - Fixed with instant local preview
    function handleAttachment(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const stepItem = input.closest('.step-item');
        const previewContainer = stepItem.querySelector('.attachment-preview');
        const fileNameSpan = stepItem.querySelector('.file-name');
        const attachLabel = stepItem.querySelector('.attach-label');
        const previewContent = stepItem.querySelector('.preview-content');
        const viewBtn = stepItem.querySelector('.btn-view-full');
        
        // Create object URL for instant local preview
        const fileUrl = URL.createObjectURL(file);
        
        // Store file reference on input element
        input.dataset.fileUrl = fileUrl;
        input.dataset.fileName = file.name;
        input.dataset.fileType = file.type;
        
        // Update UI
        attachLabel.textContent = '✓ Attached';
        fileNameSpan.textContent = file.name;
        previewContainer.style.display = 'block';
        
        // Clear existing preview
        previewContent.innerHTML = '';
        
        // Create preview based on file type
        if (file.type.startsWith('image/')) {
          // Image preview
          const img = document.createElement('img');
          img.src = fileUrl;
          img.alt = file.name;
          img.style.cssText = 'width: 100%; height: 80px; object-fit: cover; border-radius: 6px; cursor: pointer;';
          img.onclick = () => openFileInNewTab(fileUrl, file.name);
          
          img.onerror = function() {
            previewContent.innerHTML = '<div class="preview-error"><div style="font-size: 32px; margin-bottom: 8px;">🖼️</div><div style="font-weight: 600;">Preview unavailable</div></div>';
          };
          
          previewContent.appendChild(img);
        } else if (file.type === 'application/pdf') {
          // PDF icon
          const pdfIcon = document.createElement('div');
          pdfIcon.className = 'preview-icon';
          pdfIcon.innerHTML = '<div style="text-align: center; color: #667eea; padding: 16px; cursor: pointer;"><div style="font-size: 48px;">📄</div><div style="font-size: 12px; font-weight: 600; margin-top: 4px;">PDF Document</div></div>';
          pdfIcon.onclick = () => openFileInNewTab(fileUrl, file.name);
          previewContent.appendChild(pdfIcon);
        } else if (file.type.includes('word') || file.name.endsWith('.doc') || file.name.endsWith('.docx')) {
          // Word icon
          const wordIcon = document.createElement('div');
          wordIcon.className = 'preview-icon';
          wordIcon.innerHTML = '<div style="text-align: center; color: #2b5797; padding: 16px; cursor: pointer;"><div style="font-size: 48px;">📘</div><div style="font-size: 12px; font-weight: 600; margin-top: 4px;">Word Document</div></div>';
          wordIcon.onclick = () => downloadFile(fileUrl, file.name);
          previewContent.appendChild(wordIcon);
        } else if (file.type.includes('sheet') || file.type.includes('excel') || file.name.endsWith('.xls') || file.name.endsWith('.xlsx')) {
          // Excel icon
          const excelIcon = document.createElement('div');
          excelIcon.className = 'preview-icon';
          excelIcon.innerHTML = '<div style="text-align: center; color: #1d6f42; padding: 16px; cursor: pointer;"><div style="font-size: 48px;">📊</div><div style="font-size: 12px; font-weight: 600; margin-top: 4px;">Excel Spreadsheet</div></div>';
          excelIcon.onclick = () => downloadFile(fileUrl, file.name);
          previewContent.appendChild(excelIcon);
        } else if (file.type.includes('powerpoint') || file.name.endsWith('.ppt') || file.name.endsWith('.pptx')) {
          // PowerPoint icon
          const pptIcon = document.createElement('div');
          pptIcon.className = 'preview-icon';
          pptIcon.innerHTML = '<div style="text-align: center; color: #d24726; padding: 16px; cursor: pointer;"><div style="font-size: 48px;">📊</div><div style="font-size: 12px; font-weight: 600; margin-top: 4px;">PowerPoint</div></div>';
          pptIcon.onclick = () => downloadFile(fileUrl, file.name);
          previewContent.appendChild(pptIcon);
        } else if (file.type.startsWith('text/') || file.name.endsWith('.txt')) {
          // Text file icon
          const txtIcon = document.createElement('div');
          txtIcon.className = 'preview-icon';
          txtIcon.innerHTML = '<div style="text-align: center; color: #4a5568; padding: 16px; cursor: pointer;"><div style="font-size: 48px;">📝</div><div style="font-size: 12px; font-weight: 600; margin-top: 4px;">Text File</div></div>';
          txtIcon.onclick = () => openFileInNewTab(fileUrl, file.name);
          previewContent.appendChild(txtIcon);
        } else {
          // Generic file icon
          const genericIcon = document.createElement('div');
          genericIcon.className = 'preview-icon';
          genericIcon.innerHTML = '<div style="text-align: center; color: #718096; padding: 16px; cursor: pointer;"><div style="font-size: 48px;">📎</div><div style="font-size: 12px; font-weight: 600; margin-top: 4px;">File Attached</div><div style="font-size: 10px; margin-top: 4px; color: #a0aec0;">Click View to download</div></div>';
          genericIcon.onclick = () => downloadFile(fileUrl, file.name);
          previewContent.appendChild(genericIcon);
        }
        
        // Setup View button
        viewBtn.onclick = () => {
          if (file.type.startsWith('image/') || file.type === 'application/pdf' || file.type.startsWith('text/')) {
            openFileInNewTab(fileUrl, file.name);
          } else {
            downloadFile(fileUrl, file.name);
          }
        };
        
        showToast('📎', 'Attached!', `${file.name} attached successfully`);
      }
    }
    
    // Open file in new tab
    function openFileInNewTab(url, fileName) {
      const newWindow = window.open(url, '_blank');
      if (!newWindow) {
        showToast('⚠️', 'Blocked', 'Popup blocked. Please allow popups to view files.');
      } else {
        showToast('👁️', 'Opening...', `Opening ${fileName} in new tab`);
      }
    }
    
    // Download file
    function downloadFile(url, fileName) {
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('⬇️', 'Downloading...', `${fileName} download started`);
    }
    
    // Remove Attachment
    function removeAttachment(button) {
      const stepItem = button.closest('.step-item');
      const previewContainer = stepItem.querySelector('.attachment-preview');
      const fileInput = stepItem.querySelector('.step-attachment');
      const attachLabel = stepItem.querySelector('.attach-label');
      
      // Revoke object URL to free memory
      if (fileInput.dataset.fileUrl) {
        URL.revokeObjectURL(fileInput.dataset.fileUrl);
      }
      
      // Clear file input and data attributes
      fileInput.value = '';
      delete fileInput.dataset.fileUrl;
      delete fileInput.dataset.fileName;
      delete fileInput.dataset.fileType;
      
      // Reset UI
      previewContainer.style.display = 'none';
      attachLabel.textContent = 'Attach';
      
      showToast('🗑️', 'Removed!', 'Attachment removed from step');
    }

    // Switch Steps Mode
    function switchStepsMode(mode) {
      const visualEditor = document.getElementById('visualEditor');
      const rawEditorContainer = document.getElementById('rawEditorContainer');
      const tabs = document.querySelectorAll('.steps-mode-tab');
      
      tabs.forEach(tab => tab.classList.remove('active'));
      
      if (mode === 'visual') {
        visualEditor.style.display = 'block';
        rawEditorContainer.style.display = 'none';
        tabs[0].classList.add('active');
      } else {
        visualEditor.style.display = 'none';
        rawEditorContainer.style.display = 'block';
        tabs[1].classList.add('active');
        syncToRawMode();
      }
    }

