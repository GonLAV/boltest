  <script>
    let projectName = '';
    let stepCounter = 0;
    let draggedStep = null;
    let currentFocusedTextarea = null;
    
    const defaultConfig = {
      app_title: 'BOLTEST'
    };

    // Handle Login
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      const org = document.getElementById('orgName').value;
      projectName = document.getElementById('projectName').value;
      const pat = document.getElementById('patToken').value;
      
      localStorage.setItem('projectName', projectName);
      document.getElementById('sidebarProject').textContent = projectName;
      
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('appLayout').classList.add('active');
      
      showToast('✅', 'Connected!', `Successfully connected to ${projectName}`);
    });

    // Handle Logout
    function handleLogout() {
      localStorage.removeItem('projectName');
      document.getElementById('loginScreen').style.display = 'flex';
      document.getElementById('appLayout').classList.remove('active');
      document.getElementById('loginForm').reset();
      showToast('👋', 'Logged Out', 'Successfully logged out of the system');
    }

    // Toggle Dark Mode
    function toggleDarkMode() {
      document.body.classList.toggle('dark-mode');
      const toggle = document.querySelector('.toggle-switch');
      toggle.classList.toggle('active');
      
      const isDark = document.body.classList.contains('dark-mode');
      localStorage.setItem('darkMode', isDark ? 'enabled' : 'disabled');
      
      showToast('🌙', isDark ? 'Dark Mode Enabled' : 'Light Mode Enabled', `Switched to ${isDark ? 'dark' : 'light'} mode`);
    }
    
    // Toggle Sidebar
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      sidebar.classList.toggle('collapsed');
      
      const isCollapsed = sidebar.classList.contains('collapsed');
      localStorage.setItem('sidebarCollapsed', isCollapsed ? 'true' : 'false');
      
      showToast('☰', isCollapsed ? 'Menu Hidden' : 'Menu Visible', `Sidebar ${isCollapsed ? 'collapsed' : 'expanded'}`);
    }

    // Navigate Between Views
    function navigateTo(view) {
      document.querySelectorAll('#contentArea > div').forEach(el => {
        el.classList.add('hidden');
      });
      
      const viewMap = {
        'dashboard': { el: 'dashboardView', title: 'Dashboard' },
        'myStories': { el: 'myStoriesView', title: 'My User Stories' },
        'teamTests': { el: 'teamTestsView', title: 'Team Tests' },
        'create': { el: 'createView', title: 'Create Test Case' },
        'api': { el: 'createView', title: 'API Runner' }
      };
      
      if (viewMap[view]) {
        document.getElementById(viewMap[view].el).classList.remove('hidden');
        document.getElementById('pageTitle').textContent = viewMap[view].title;
      }
      
      document.querySelectorAll('.nav-item').forEach(item => {
        item.classList.remove('active');
      });
      if (event && event.currentTarget) {
        event.currentTarget.classList.add('active');
      }
    }

    // Toggle Header
    function toggleHeader() {
      const header = document.getElementById('mainHeader');
      header.classList.toggle('collapsed');
      const btn = event.currentTarget;
      btn.textContent = header.classList.contains('collapsed') ? '⬇️' : '⬆️';
      btn.title = header.classList.contains('collapsed') ? 'Expand Header' : 'Collapse Header';
    }

    // Filter Stories
    function filterStories(filter) {
      const cards = document.querySelectorAll('.story-card');
      const buttons = document.querySelectorAll('.filter-bar .filter-btn');
      
      buttons.forEach(btn => btn.classList.remove('active'));
      if (event && event.currentTarget) {
        event.currentTarget.classList.add('active');
      }
      
      cards.forEach(card => {
        if (filter === 'all') {
          card.style.display = 'block';
        } else if (filter === 'noTests') {
          card.style.display = card.dataset.hasTests === 'false' ? 'block' : 'none';
        } else if (filter === 'hasTests') {
          card.style.display = card.dataset.hasTests === 'true' ? 'block' : 'none';
        }
      });
    }

    // Search Stories
    function searchStories(query) {
      const cards = document.querySelectorAll('.story-card');
      const lowerQuery = query.toLowerCase();
      
      cards.forEach(card => {
        const title = card.querySelector('.story-title').textContent.toLowerCase();
        const id = card.querySelector('.story-id').textContent.toLowerCase();
        card.style.display = (title.includes(lowerQuery) || id.includes(lowerQuery)) ? 'block' : 'none';
      });
    }

    // Add Test to Story
    function addTestToStory(storyId) {
      navigateTo('create');
      showToast('➕', 'Creating Test', `Creating test case for ${storyId}`);
      setTimeout(() => {
        document.getElementById('testTitle').value = `TC for ${storyId}`;
        document.getElementById('testTitle').focus();
      }, 300);
    }

    // View Story Tests
    function viewStoryTests(storyId) {
      showToast('👁️', 'Loading Tests', `Loading all tests for ${storyId}`);
    }
    
    // Toggle Group Menu
    function toggleGroupMenu() {
      const menu = document.getElementById('groupMenu');
      const teamMenu = document.getElementById('teamMenu');
      const isVisible = menu.style.display === 'block';
      
      // Close team menu if open
      if (teamMenu) teamMenu.style.display = 'none';
      
      menu.style.display = isVisible ? 'none' : 'block';
    }
    
    // Toggle Team Menu
    function toggleTeamMenu() {
      const menu = document.getElementById('teamMenu');
      const groupMenu = document.getElementById('groupMenu');
      const isVisible = menu.style.display === 'block';
      
      // Close group menu if open
      if (groupMenu) groupMenu.style.display = 'none';
      
      menu.style.display = isVisible ? 'none' : 'block';
    }
    
    // Filter by Group
    function filterByGroup(group) {
      const cards = document.querySelectorAll('.story-card');
      
      cards.forEach(card => {
        if (group === 'all') {
          card.style.display = 'block';
        } else {
          card.style.display = card.dataset.group === group ? 'block' : 'none';
        }
      });
      
      const groupNames = {
        'all': 'All Groups',
        'authentication': 'Authentication',
        'account': 'Account Management',
        'forms': 'Forms & Submissions',
        'documents': 'Documents',
        'notifications': 'Notifications'
      };
      
      document.getElementById('groupMenu').style.display = 'none';
      showToast('🏷️', 'Filtered!', `Showing ${groupNames[group]}`);
    }
    
    // Filter by Team
    function filterByTeam(teamMember) {
      const cards = document.querySelectorAll('.story-card');
      
      cards.forEach(card => {
        if (teamMember === 'all') {
          card.style.display = 'block';
        } else {
          card.style.display = card.dataset.team === teamMember ? 'block' : 'none';
        }
      });
      
      document.getElementById('teamMenu').style.display = 'none';
      showToast('👥', 'Filtered!', `Showing ${teamMember === 'all' ? 'All Teams' : teamMember + "'s Team"}`);
    }
    
    // Search Team Members
    function searchTeamMembers(query) {
      const buttons = document.querySelectorAll('.team-member-btn');
      const lowerQuery = query.toLowerCase();
      
      buttons.forEach(btn => {
        const memberName = btn.dataset.member;
        const teamPath = btn.dataset.team;
        const matchesMember = memberName && memberName.toLowerCase().includes(lowerQuery);
        const matchesPath = teamPath && teamPath.toLowerCase().includes(lowerQuery);
        
        btn.style.display = (matchesMember || matchesPath) ? 'flex' : 'none';
      });
    }
    
    // Close menus when clicking outside
    document.addEventListener('click', function(e) {
      const groupMenu = document.getElementById('groupMenu');
      const groupBtn = document.getElementById('groupFilterBtn');
      const teamMenu = document.getElementById('teamMenu');
      const teamBtn = document.getElementById('teamFilterBtn');
      
      if (groupMenu && groupBtn && !groupMenu.contains(e.target) && !groupBtn.contains(e.target)) {
        groupMenu.style.display = 'none';
      }
      
      if (teamMenu && teamBtn && !teamMenu.contains(e.target) && !teamBtn.contains(e.target)) {
        teamMenu.style.display = 'none';
      }
      
      // Close all formatting toolbars and dropdowns when clicking outside
      const toolbars = document.querySelectorAll('.formatting-toolbar');
      const dropdowns = document.querySelectorAll('.color-picker-dropdown, .size-picker-dropdown, .emoji-picker-dropdown');
      
      toolbars.forEach(toolbar => {
        if (!toolbar.contains(e.target) && !e.target.classList.contains('step-action') && !e.target.classList.contains('step-expected')) {
          toolbar.classList.remove('active');
        }
      });
      
      dropdowns.forEach(dropdown => {
        if (!dropdown.contains(e.target) && !dropdown.previousElementSibling.contains(e.target)) {
          dropdown.classList.remove('active');
        }
      });
    });

    // Show Formatting Toolbar on Focus
    function showToolbar(textarea) {
      // Hide all other toolbars
      document.querySelectorAll('.formatting-toolbar').forEach(t => t.classList.remove('active'));
      
      // Show toolbar for this textarea
      const wrapper = textarea.closest('.step-field-wrapper');
      const toolbar = wrapper.querySelector('.formatting-toolbar');
      if (toolbar) {
        toolbar.classList.add('active');
        currentFocusedTextarea = textarea;
      }
    }

    // Format Text - Enhanced version
    function formatText(format) {
      if (!currentFocusedTextarea) return;
      
      const textarea = currentFocusedTextarea;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const selectedText = textarea.value.substring(start, end);
      
      if (!selectedText) {
        showToast('⚠️', 'No Selection', 'Please select text to format');
        return;
      }
      
      let formattedText = '';
      const formatMap = {
        'bold': `<b>${selectedText}</b>`,
        'italic': `<i>${selectedText}</i>`,
        'underline': `<u>${selectedText}</u>`,
        'left': `<div align="left">${selectedText}</div>`,
        'center': `<div align="center">${selectedText}</div>`,
        'right': `<div align="right">${selectedText}</div>`,
        'code': `<code>${selectedText}</code>`,
        'list': `<ul><li>${selectedText}</li></ul>`,
        'numlist': `<ol><li>${selectedText}</li></ol>`,
        'link': `<a href="URL">${selectedText}</a>`,
        'mention': `@${selectedText}`,
        'tag': `#${selectedText}`
      };
      
      formattedText = formatMap[format] || selectedText;
      
      textarea.value = textarea.value.substring(0, start) + formattedText + textarea.value.substring(end);
      textarea.focus();
      textarea.setSelectionRange(start, start + formattedText.length);
      
      syncToRawMode();
      showToast('✨', 'Formatted!', `Applied ${format} formatting`);
    }
    
