    // Parse Raw Steps
    function parseRawSteps() {
      const rawText = document.getElementById('rawEditor').value;
      if (!rawText.trim()) {
        showToast('⚠️', 'Empty Content', 'Please paste test steps in the raw editor');
        return;
      }

      stepCounter = 0;
      document.getElementById('stepsGrid').innerHTML = '';

      const lines = rawText.split('\n');
      let titleLine = '';
      let descLine = '';
      let stepsStartIndex = 0;

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (line.toUpperCase().startsWith('TITLE')) {
          titleLine = line.replace(/^TITLE\s*/i, '').trim();
        } else if (line.toUpperCase().startsWith('DESCRIPTION')) {
          descLine = line.replace(/^DESCRIPTION\s*/i, '').trim();
        } else if (/^Step/i.test(line)) {
          stepsStartIndex = i;
          break;
        }
      }

      if (titleLine) {
        document.getElementById('testTitle').value = titleLine;
      }
      if (descLine) {
        document.getElementById('testDescription').value = descLine;
      }

      let currentStep = null;
      let parsedCount = 0;
      let currentField = null;

      for (let i = stepsStartIndex; i < lines.length; i++) {
        const line = lines[i];
        const trimmedLine = line.trim();
        
        if (/^Step(\s+\d+)?:?\s*$/i.test(trimmedLine)) {
          if (currentStep) {
            addTestStep(currentStep.action, currentStep.expected, currentStep.data, true);
            parsedCount++;
          }
          currentStep = { action: '', expected: '', data: '' };
          currentField = null;
        } else if (currentStep !== null) {
          if (/^\s*Action:/i.test(line)) {
            currentField = 'action';
            const value = line.replace(/^\s*Action:\s*/i, '').trim();
            currentStep.action = value;
          } else if (/^\s*Expected:/i.test(line)) {
            currentField = 'expected';
            const value = line.replace(/^\s*Expected:\s*/i, '').trim();
            currentStep.expected = value;
          } else if (/^\s*Data:/i.test(line)) {
            currentField = 'data';
            const value = line.replace(/^\s*Data:\s*/i, '').trim();
            currentStep.data = value;
          } else if (trimmedLine && currentField) {
            const currentValue = currentStep[currentField];
            currentStep[currentField] = currentValue ? currentValue + ' ' + trimmedLine : trimmedLine;
          }
        }
      }

      if (currentStep !== null) {
        addTestStep(currentStep.action, currentStep.expected, currentStep.data, true);
        parsedCount++;
      }

      if (parsedCount > 0) {
        syncToRawMode();
        document.querySelectorAll('.steps-mode-tab')[0].click();
        showToast('✅', 'Imported!', `${parsedCount} steps imported successfully`);
      } else {
        showToast('⚠️', 'No Steps Found', 'No steps found. Use format: Step 1:, Action:, Expected:');
      }
    }

